# Copy this file to .env.local for local development.
# Set the URL to the exact port shown by `bun dev` (example below uses 3001).
BETTER_AUTH_URL=http://localhost:3001
# Generate a private random secret, e.g. `bun -e "console.log(crypto.randomUUID()+crypto.randomUUID())"`
BETTER_AUTH_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
